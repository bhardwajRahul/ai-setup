{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "claude-code": [
        "./plugin/fast-jev-compaction/types/claude-code.d.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    "plugin/**/*.ts",
    "plugin/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
